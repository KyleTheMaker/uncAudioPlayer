{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["jest"],
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
